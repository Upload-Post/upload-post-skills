UPLOAD_POST_API_KEY=your_upload_post_api_key
UPLOAD_POST_PROFILE=your_upload_post_profile_name
GEMINI_API_KEY=your_gemini_api_key

# Absolute paths. On Windows use forward slashes (pathlib handles them) or
# escaped backslashes -- e.g. C:/Users/you/Videos/longform
#   Windows : C:/Users/you/Videos/longform
#   macOS   : /Users/you/Movies/longform
#   Linux   : /home/you/videos/longform
# Leave both unset to default to input/ and output/ next to autoshorts.py.
INPUT_FOLDER=
OUTPUT_FOLDER=

WHISPER_MODEL=medium
TIMEZONE=Europe/Madrid

# Optional. Font used for the hook overlay. Auto-detected per platform
# (Impact on Windows/macOS, DejaVu Sans Bold on Linux) -- set this only to
# override, or if none of the defaults are installed.
HOOK_FONT=
